{
  "name": "tyremate-web",
  "version": "2.0.0",
  "private": true,
  "description": "TyreMate ERP - Next.js web edition (static export for GitHub Pages)",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare.mjs",
    "build": "next build --webpack",
    "start": "node tests/helpers/pagesServer.mjs out 3000",
    "typecheck": "node scripts/prepare.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:pages && playwright test --trace off",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/tyremate-web npm run build",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "events": "^3.3.0",
    "lucide-react": "^1.20.0",
    "marked": "^15.0.12",
    "next": "^16.4.6",
    "path-browserify": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.13.0",
    "uuid": "^14.0.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
