# ==============================================================================
# TyreMate Environment Configuration Template
# ==============================================================================
# To use these locally:
# 1. Copy this file to `.env.local` (never committed to git)
# 2. Fill in your Turso remote database credentials below.
# ==============================================================================

# Turso / libSQL Shared Database Credentials (for development)
NEXT_PUBLIC_DEV_DB_URL=libsql://your-database-name.turso.io
NEXT_PUBLIC_DEV_DB_TOKEN=your-turso-auth-token

# Optional: Turso Credentials for Production build testing
# NEXT_PUBLIC_PROD_DB_URL=libsql://your-prod-database-name.turso.io
# NEXT_PUBLIC_PROD_DB_TOKEN=your-prod-turso-auth-token

# Cloudinary Storage Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dkj22lm1g
NEXT_PUBLIC_CLOUDINARY_STATIC_FOLDER=tyremate/static
